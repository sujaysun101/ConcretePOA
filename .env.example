# ==============================================================================
# ConcretePOA Environment Variables
# ==============================================================================
# Secrets must NEVER be checked into git or prefixed with NEXT_PUBLIC_ unless
# explicitly meant for public browser distribution.
# ==============================================================================

# Clerk Authentication (Required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk webhook secret for verifying incoming webhooks (Phase 2)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder

# Database Configuration (Postgres / Neon)
# In production, DATABASE_URL is strictly required; in-memory fallback is disabled.
DATABASE_URL=postgres://user:password@host:5432/concretepoa?sslmode=require
# Unpooled direct connection string used for schema migrations (Phase 3)
DATABASE_URL_MIGRATIONS=postgres://user:password@host:5432/concretepoa?sslmode=require

# AI Provider Configuration
# AI_PROVIDER can be 'anthropic' (default) or 'google'
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-placeholder
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy_placeholder
AI_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS=4096
# Daily USD spend ceiling (pauses analysis when reached to prevent overruns)
AI_DAILY_SPEND_CAP_USD=25

# Upstash Redis (Distributed Rate Limiting & Spend Metering)
# Required in production; fallback in-memory token bucket used in local dev only.
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder_token

# Application-Level Field Encryption (Phase 3)
# 32-byte base64 AES-256-GCM key: generate with `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=placeholder_base64_32_bytes_key==
DATA_ENCRYPTION_KEY_ID=k1
# JSON mapping of previous key IDs for zero-downtime key rotation: e.g. {"k0":"old_base64_key=="}
DATA_ENCRYPTION_KEYS_PREVIOUS={}

# Audit Log Pseudonymization Salt
# Generate with `openssl rand -base64 32`
AUDIT_HASH_SALT=placeholder_audit_salt==

# Vercel Cron Secret (Phase 3)
CRON_SECRET=placeholder_cron_secret

# Public Application Metadata
NEXT_PUBLIC_APP_URL=https://concrete-poa.vercel.app
CONTACT_EMAIL=support@concretepoa.com

# Development & Local Testing Only (STRICTLY FORBIDDEN IN PRODUCTION)
# DEMO_SCREENSHOT=1 leaves /demo accessible without authentication for screenshots.
# In production, any attempt to run with DEMO_SCREENSHOT=1 will throw a fatal error.
DEMO_SCREENSHOT=
