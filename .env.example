# Canonical Clerk publishable key for Next.js.
# The previous Vite app used VITE_CLERK_PUBLISHABLE_KEY. This server still
# accepts that name as a fallback so existing preview environments keep working.
# Rename it to NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in the host dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Postgres connection string (Neon or Supabase). When unset, the app uses an
# in-memory store labeled "Demo data".
DATABASE_URL=

# Optional. Seed script writes demo matters into this Clerk organization id.
SEED_ORG_ID=

# Server-only model access. Never expose this to the browser.
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-4-5. Hard-capped at 8192 tokens.
AI_MODEL=
AI_MAX_TOKENS=

# Optional Upstash Redis REST credentials for per-user rate limits.
# When unset, an in-memory token bucket is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL used for metadata. No trailing path required.
NEXT_PUBLIC_APP_URL=

# Set to 1 only while capturing portfolio screenshots. Leaves /demo reachable
# without a session. Do not set this in production.
DEMO_SCREENSHOT=
