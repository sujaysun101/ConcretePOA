# Gemini API key (used server-side in production; client-side for dev/demo only).
# For production, move Gemini calls to a backend and keep this key secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Clerk authentication — get your publishable key from https://dashboard.clerk.com
# This key is safe to expose in the browser.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# The URL where this app is hosted (used for OAuth callbacks).
APP_URL="MY_APP_URL"
