{
  "name": "concretepoa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "eval": "tsx --conditions=react-server scripts/run-evals.ts",
    "eval:generate": "tsx scripts/generate-eval-cases.ts",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@clerk/nextjs": "^6.33.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "framer-motion": "^12.23.12",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.546.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "svix": "^2.9.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.2",
    "msw": "^2.15.0",
    "playwright": "^1.55.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
